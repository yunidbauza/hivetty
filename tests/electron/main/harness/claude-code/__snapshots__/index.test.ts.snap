exports[`the files a Claude Code session is launched with > agent settings, command 1`] = `
{
  "hive/claude-agent.settings.json": {
    "content": "{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 3 -X POST http://127.0.0.1:60123/hook -H 'content-type: application/json' -H \\"x-hive-session: $HIVE_SESSION_ID\\" -H \\"x-hive-token: $HIVE_HOOK_TOKEN\\" --data-binary @- 2>/dev/null || true",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 3 -o /dev/null -X POST http://127.0.0.1:60123/ready -H \\"x-hive-session: $HIVE_SESSION_ID\\" -H \\"x-hive-token: $HIVE_HOOK_TOKEN\\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
