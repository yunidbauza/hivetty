            "headers": {
              "x-hive-session": "$HIVE_SESSION_ID",
              "x-hive-token": "$HIVE_HOOK_TOKEN"
            },
            "allowedEnvVars": [
              "HIVE_SESSION_ID",
              "HIVE_HOOK_TOKEN"
            ],
            "timeout": 3
          }
        ]
