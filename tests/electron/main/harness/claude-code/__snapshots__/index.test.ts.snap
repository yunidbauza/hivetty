exports[`the files a Claude Code session is launched with > agent settings, http 1`] = `
{
  "hive/claude-agent.settings.json": {
    "content": "{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
