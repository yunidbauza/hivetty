      }
    ]
  },
  "disableAgentView": true,
  "theme": "dark-ansi",
  "permissions": {
    "ask": [
      "mcp__hive__project_auto_merge"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/sh '/hive/container/aliases/gateway/statusline.sh'",
    "refreshInterval": 30
  }
}
",
    "mode": "644",
  },
  "hive/container/aliases/gateway/hive.mcp.json": {
    "content": "{
  "mcpServers": {
    "hive": {
      "type": "http",
      "url": "\${HIVE_RECEIVER_URL}/mcp",
      "headers": {
        "x-hive-session": "\${HIVE_SESSION_ID}",
        "x-hive-token": "\${HIVE_HOOK_TOKEN}",
        "x-hive-run": "\${HIVE_RUN_ID:-}",
        "x-hive-run-token": "\${HIVE_RUN_TOKEN:-}"
      }
    }
  }
}
",
    "mode": "644",
  },
  "hive/container/aliases/gateway/statusline.sh": {
    "content": "#!/bin/sh
# The Hive — session usage reporter. Written per launch; do not edit.
# Reads Claude Code's status line payload on stdin, forwards it to the app, and
# prints nothing so no status line is rendered. See electron/main/harness/claude-code/settings.ts.
[ -n "$HIVE_SESSION_ID" ] || exit 0
[ -n "$HIVE_HOOK_TOKEN" ] || exit 0

curl -s -m 5 -o /dev/null \\
  -X POST 'http://gateway:60123/metrics' \\
  -H 'content-type: application/json' \\
  -H "x-hive-session: $HIVE_SESSION_ID" \\
  -H "x-hive-token: $HIVE_HOOK_TOKEN" \\
  --data-binary @- 2>/dev/null

exit 0
",
    "mode": "700",
  },
}
`;

exports[`the files a Claude Code session is launched with > plugin dir, done url absent 1`] = `
{
  "plugin/.claude-plugin/plugin.json": {
    "content": "{
  "name": "hive",
  "version": "1.2.3",
  "description": "Skills Hive TTY injects into the sessions it starts.",
  "skills": [
    "./skills/"
  ]
}
",
    "mode": "644",
  },
  "plugin/skills/done/SKILL.md": {
    "content": "---
name: done
description: >-
  Finish this session — mark it done in The Hive and close its terminal. Use it
  when the work a session was opened for is complete, either because the user
  asked to finish or because a skill has finished its task and is handing off.
  Closing is recoverable; the transcript stays readable afterwards.
---

This session cannot be closed automatically: The Hive is not reachable from it,
so there is nowhere to report that the work is finished.

Tell the user exactly that, in one line, and suggest they type \`/exit\` to close
the terminal themselves. Do not run any command.
",
    "mode": "644",
  },
  "plugin/skills/review/SKILL.md": {
    "content": "---
name: review
description: Review the diff
---
Read it closely.
",
    "mode": "644",
  },
}
`;

exports[`the files a Claude Code session is launched with > plugin dir, done url present 1`] = `
{
  "plugin/.claude-plugin/plugin.json": {
    "content": "{
  "name": "hive",
  "version": "1.2.3",
  "description": "Skills Hive TTY injects into the sessions it starts.",
  "skills": [
    "./skills/"
  ]
}
",
    "mode": "644",
  },
  "plugin/skills/done/SKILL.md": {
    "content": "---
name: done
description: >-
  Finish this session — mark it done in The Hive and close its terminal. Use it
  when the work a session was opened for is complete, either because the user
  asked to finish or because a skill has finished its task and is handing off.
  Closing is recoverable; the transcript stays readable afterwards.
allowed-tools: 'Bash(curl -sS --fail -m 5 -X POST "$HIVE_RECEIVER_URL/done" -H "x-hive-session: $HIVE_SESSION_ID" -H "x-hive-token: $HIVE_HOOK_TOKEN")'
---

Run exactly this command:

\`\`\`sh
curl -sS --fail -m 5 -X POST "$HIVE_RECEIVER_URL/done" -H "x-hive-session: $HIVE_SESSION_ID" -H "x-hive-token: $HIVE_HOOK_TOKEN"
\`\`\`

That request tells The Hive this session is finished. The app closes the
terminal itself once the turn ends — you cannot close it yourself, and you do
not need to.

Then stop. Do not summarise, do not explain, and do not run anything else.
",
    "mode": "644",
  },
  "plugin/skills/review/SKILL.md": {
    "content": "---
name: review
description: Review the diff
---
Read it closely.
",
    "mode": "644",
  },
}
`;

