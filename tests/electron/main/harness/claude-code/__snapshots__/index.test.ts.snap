  "hive/container/hive.mcp.json": {
    "content": "{
  "mcpServers": {
    "hive": {
      "type": "http",
      "url": "\${HIVE_RECEIVER_URL}/mcp",
      "headers": {
        "x-hive-session": "\${HIVE_SESSION_ID}",
        "x-hive-token": "\${HIVE_HOOK_TOKEN}",
        "x-hive-run": "\${HIVE_RUN_ID:-}",
        "x-hive-run-token": "\${HIVE_RUN_TOKEN:-}"
      }
    }
  }
}
",
    "mode": "644",
  },
  "hive/container/statusline.sh": {
    "content": "#!/bin/sh
# The Hive — session usage reporter. Written per launch; do not edit.
# Reads Claude Code's status line payload on stdin, forwards it to the app, and
# prints nothing so no status line is rendered. See electron/main/harness/claude-code/settings.ts.
[ -n "$HIVE_SESSION_ID" ] || exit 0
[ -n "$HIVE_HOOK_TOKEN" ] || exit 0

curl -s -m 5 -o /dev/null \\
  -X POST 'http://host.docker.internal:60123/metrics' \\
  -H 'content-type: application/json' \\
  -H "x-hive-session: $HIVE_SESSION_ID" \\
  -H "x-hive-token: $HIVE_HOOK_TOKEN" \\
  --data-binary @- 2>/dev/null

exit 0
",
    "mode": "700",
  },
}
`;

